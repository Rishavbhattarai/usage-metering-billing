# Copy to .env and adjust. Never commit .env.

# Host ports for docker compose. Defaults: API 8001, jobq API 8002, Postgres 5433.
# API_PORT=8001
# JOBQ_API_PORT=8002
# POSTGRES_PORT=5433
# Build jobq from a local checkout instead of GitHub:
# JOBQ_CONTEXT=../distributed-job-queue

# API / CLI / migrations when run outside Docker (Postgres published on host port 5433).
DATABASE_URL=postgresql+asyncpg://metering:metering@localhost:5433/metering
MAX_BATCH_SIZE=5000

# Integration tests. This database is WIPED by the test run (as is <name>_replay).
TEST_DATABASE_URL=postgresql+asyncpg://metering:metering@localhost:5433/metering_test

# Jobs: with JOBQ_URL set (and jobq installed: pip install -e ".[jobq]") jobs go to jobq;
# without it they run in-process.
# JOBQ_URL=http://localhost:8002

# Billing
CLOSE_CUTOFF_LAG_SECONDS=60
AGGREGATE_OVERLAP_SECONDS=30

# Salesforce: "fake" (default) or "live". See docs/salesforce-setup.md.
SALESFORCE_MODE=fake
# FAKE_SF_STATE=.fake-salesforce.json
SF_USERNAME=you@example.dev
SF_CONSUMER_KEY=
# Keep the private key OUTSIDE the repo; only its path goes here.
SF_PRIVATE_KEY_PATH=~/.salesforce/metering-jwt/server.key
SF_DOMAIN=login
