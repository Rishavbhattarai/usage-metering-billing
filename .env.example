# Copy to .env and adjust. Never commit .env.

# API / migrations. Matches docker-compose.yml (Postgres published on host port 5433).
DATABASE_URL=postgresql+asyncpg://metering:metering@localhost:5433/metering
MAX_BATCH_SIZE=5000

# Integration tests. This database is WIPED by the test run.
TEST_DATABASE_URL=postgresql+asyncpg://metering:metering@localhost:5433/metering_test

# Project 1 job queue (read by jobq's client; not wired up yet, see src/metering/jobs/queue.py).
# jobq defaults to :8000, which this API also uses, so run one of them on another port.
JOBQ_URL=http://localhost:8001

# Salesforce (Week 0 / push 3/3). See docs/salesforce-setup.md.
# Keep the private key OUTSIDE the repo; only its path goes here.
SF_USERNAME=you@example.dev
SF_CONSUMER_KEY=
SF_PRIVATE_KEY_PATH=~/.salesforce/metering-jwt/server.key
SF_DOMAIN=login
